[Unit]
Description=Deploy RTM Education from GitHub main
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=rtmdeploy
Group=rtmdeploy
Environment=COMPOSE_PROJECT_NAME=rtm-education
ExecStart=/usr/bin/bash /opt/rtm-app/deploy/rtm-deploy.sh
TimeoutStartSec=1800

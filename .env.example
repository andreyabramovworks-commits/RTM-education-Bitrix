POSTGRES_DB=rtm_education
POSTGRES_USER=rtm_app
POSTGRES_PASSWORD=change-me-to-a-long-random-value
APP_ENV=development
APP_VERSION=dev
# Browser telemetry. Values beginning with VITE_ are intentionally embedded in the frontend bundle.
VITE_APP_ENV=development
VITE_APP_VERSION=dev
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
BITRIX_PORTAL_HOST=rtm-group.bitrix24.ru
KNOWLEDGE_SYNC_SECRET=
PUBLIC_ORIGIN=http://localhost:5173
# Server-only OAuth values. Never expose these in frontend code or commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
RCLONE_REMOTE=
RCLONE_DEVELOPER_REMOTE=
REMOTE_DAILY_KEEP=7
REMOTE_MONTHLY_KEEP=3
REMOTE_MAX_BYTES=3221225472
DOMAIN=:80
